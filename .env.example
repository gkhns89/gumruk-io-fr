# Backend API
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_ENV=development

# G-Radar cargo map (MapLibre GL)
# Default style: OpenFreeMap (https://openfreemap.org) — free, no signup, no API key.
# For production-grade tiles with better SLA, sign up at https://www.maptiler.com
# (free tier: 100k loads/month) and paste the key below — the map component
# automatically switches to MapTiler when this is set.
VITE_MAPTILER_API_KEY=

# Google Analytics 4 measurement ID (G-...), landing and legal pages only, loaded
# only after cookie consent. Set it in Vercel for Production ONLY: leave it empty
# here and in Preview so local and staging visits never reach the GA4 property.
VITE_GA_MEASUREMENT_ID=
